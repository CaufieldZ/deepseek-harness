{
  "name": "@deepseek-ai/dsh-vscode",
  "description": "VSCode extension for the dsh harness: spawns the harness child process, manages the DeepSeek credential, and serves sessions as editor tabs",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/vscode"
  },
  "type": "module",
  "main": "lib/extension.cjs",
  "publisher": "caufieldz",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dsh.setApiKey",
        "title": "Set DeepSeek API Key",
        "category": "dsh"
      },
      {
        "command": "dsh.importApiKeyFromSettings",
        "title": "Import DeepSeek API Key from ACP Client Settings",
        "category": "dsh"
      },
      {
        "command": "dsh.restartChild",
        "title": "Restart Harness Child Process",
        "category": "dsh"
      },
      {
        "command": "dsh.newSession",
        "title": "New Session",
        "category": "dsh"
      },
      {
        "command": "dsh.openSession",
        "title": "Open Session",
        "category": "dsh"
      },
      {
        "command": "dsh.reopenClosedSession",
        "title": "Reopen Closed Session",
        "category": "dsh"
      },
      {
        "command": "dsh.acceptDiff",
        "title": "Accept Change",
        "category": "dsh"
      },
      {
        "command": "dsh.rejectDiff",
        "title": "Reject Change",
        "category": "dsh"
      },
      {
        "command": "dsh.toggleAutomode",
        "title": "Toggle Auto/Manual Permission Mode",
        "category": "dsh"
      },
      {
        "command": "dsh.setPermissionMode",
        "title": "Set Permission Mode…",
        "category": "dsh"
      },
      {
        "command": "dsh.stopSession",
        "title": "Stop Current Session",
        "category": "dsh"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dsh.newSession"
        },
        {
          "command": "dsh.reopenClosedSession"
        }
      ],
      "view/title": [
        {
          "command": "dsh.newSession",
          "when": "view == dsh.sessions",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "dsh.acceptDiff",
          "when": "dsh.pendingDiff && resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "dsh.rejectDiff",
          "when": "dsh.pendingDiff && resourceScheme == file",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dsh.newSession",
        "key": "cmd+n",
        "mac": "cmd+n",
        "when": "dsh.enableNewConversationShortcut"
      },
      {
        "command": "dsh.reopenClosedSession",
        "key": "cmd+shift+t",
        "mac": "cmd+shift+t",
        "when": "dsh.enableReopenClosedSessionShortcut"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "dsh",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "id": "dsh.sessions",
          "name": "Sessions"
        }
      ]
    },
    "configuration": {
      "title": "dsh",
      "properties": {
        "dsh.command": {
          "type": "string",
          "default": "dsh",
          "markdownDescription": "Command spawned as the harness child: the `dsh` bin on PATH, or an absolute path to a built bin (see `#dsh.node#`)."
        },
        "dsh.profile": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "web"
          ],
          "markdownDescription": "Profile the child boots. `vscode` adds the IDE-context feed and Claude Code hook compatibility; `web` is the plain browser surface."
        },
        "dsh.node": {
          "type": "string",
          "default": "",
          "markdownDescription": "When set, the child command is launched through this Node executable, e.g. `node` together with an absolute path in `#dsh.command#`. Empty spawns `#dsh.command#` directly. Never point this at the extension host (Electron)."
        },
        "dsh.home": {
          "type": "string",
          "default": "",
          "markdownDescription": "`DSH_HOME` for the child process (session store, profiles). Empty inherits the child default (`~/.dsh`)."
        },
        "dsh.spawnTimeoutMs": {
          "type": "number",
          "default": 30000,
          "markdownDescription": "Milliseconds to wait for the child's ready line before killing it and retrying."
        },
        "dsh.extraEnv": {
          "type": "object",
          "default": {},
          "markdownDescription": "Extra environment entries for the child, merged after the credential entry. Use for `DEEPSEEK_BASE_URL`-style deployment overrides."
        },
        "dsh.enableNewConversationShortcut": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use Cmd/Ctrl+N to start a new session when the dsh views are focused."
        },
        "dsh.enableReopenClosedSessionShortcut": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use Cmd/Ctrl+Shift+T to reopen the most recently closed dsh session."
        },
        "dsh.preferredLocation": {
          "type": "string",
          "default": "tab",
          "enum": [
            "tab"
          ],
          "markdownDescription": "Where dsh sessions open. `tab` (editor tabs) ships today."
        },
        "dsh.initialPermissionMode": {
          "type": "string",
          "default": "manual",
          "enum": [
            "manual",
            "auto",
            "fullAccess"
          ],
          "markdownDescription": "Permission mode the harness child starts from (the new-session default). `manual` asks before every file change, `auto` allows workspace edits and asks for wider writes, `fullAccess` never prompts."
        }
      }
    }
  },
  "files": [
    "lib/extension.cjs",
    "webview-dist/**",
    "curated/**",
    "media/**",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build:webview": "tsx webview/build.ts",
    "build:bundle": "tsx scripts/bundle.ts",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-client-web": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-host-apiproxy": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-session-title": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-vscode-context": "workspace:^",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "@types/vscode": "^1.100.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.5.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.0.0",
    "ws": "^8.21.0"
  }
}